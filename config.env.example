# Copy to config.env (git-ignored) and fill in. Environment variables override this file.

# The gateway's key pair: clients encrypt their tokens to it. Path of a JWK Set file kept outside the repository
# and the image; the app does not start without it. Create it with:
#   python -m ops.gateway_key generate <file>
GATEWAY_KEYS_FILE=
# What clients put in the aud of their tokens. Use the public URL of this deployment.
GATEWAY_AUDIENCE=
# The key service that holds the master key (an OpenBao). Each client's data is encrypted with a key it wraps;
# until it answers, whatever needs a key gets a 503. Outside development the address must be https.
ANDVARI_ADDR=
ANDVARI_ROLE_ID=
# Path of the file with the AppRole secret id, and of the CA that signed the key service's certificate.
ANDVARI_SECRET_ID_FILE=
ANDVARI_CA_FILE=
# Where the register of erasures is kept: every deletion is written there before it is made, so that it can be
# made again after a backup of the database is restored. A directory that outlives the container, is backed up,
# and is not the database. While it cannot be written, nothing is deleted. Default: erasures
ERASURES_DIR=
# Meta App Secret (App Dashboard > App settings > Basic). Verifies X-Hub-Signature-256 on the webhook.
# Optional only if every chatbot document carries its own appSecret.
FACEBOOK_APP_SECRET=

CLIENT_ID=
NATIONAL_ID_URL=

DB_NAME=
DB_HOST=
DB_USERNAME=
DB_PASSWORD=

SENDER_EMAIL=
SENDER_PASSWORD=

GMAIL_SERVER_URL=
GMAIL_SERVER_PORT=

EXPIRATION_TIME=
ACTIVATION_CODE_LENGTH=
PASSWORD_LENGTH=

QMS_SERVER=
QMS_USER=
QMS_PASSWORD=

KEY_SIZE=3072
PRIVATE_KEY_FILENAME=certs/{UUID}_private.pem
PUBLIC_KEY_FILENAME=certs/{UUID}_public.pem

# development | staging | production
ENVIRONMENT=development
VERSION=0.0.1

VERIFY_TOKEN=

# Templates: {fb_id} and {ACCESSTOKEN} / {version} and {PhoneNumberId} are filled in by the app.
FACEBOOK_GRAPH_URL=
FACEBOOK_WHATSAPP_MESSAGE=
FACEBOOK_GRAPH_VERSION=v19.0
