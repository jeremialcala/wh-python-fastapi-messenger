# Copy to config.env (git-ignored) and fill in. Environment variables override this file.

# The gateway's key pair: clients encrypt their tokens to it. Path of a JWK Set file kept outside the repository
# and the image; the app does not start without it. Create it with:
#   python -m ops.gateway_key generate <file>
GATEWAY_KEYS_FILE=
# What clients put in the aud of their tokens. Use the public URL of this deployment.
GATEWAY_AUDIENCE=
# Meta App Secret (App Dashboard > App settings > Basic). Verifies X-Hub-Signature-256 on the webhook.
# Optional only if every chatbot document carries its own appSecret.
FACEBOOK_APP_SECRET=

CLIENT_ID=
NATIONAL_ID_URL=

DB_NAME=
DB_HOST=
DB_USERNAME=
DB_PASSWORD=

SENDER_EMAIL=
SENDER_PASSWORD=

GMAIL_SERVER_URL=
GMAIL_SERVER_PORT=

EXPIRATION_TIME=
ACTIVATION_CODE_LENGTH=
PASSWORD_LENGTH=

QMS_SERVER=
QMS_USER=
QMS_PASSWORD=

KEY_SIZE=3072
PRIVATE_KEY_FILENAME=certs/{UUID}_private.pem
PUBLIC_KEY_FILENAME=certs/{UUID}_public.pem

# development | staging | production
ENVIRONMENT=development
VERSION=0.0.1

VERIFY_TOKEN=

# Templates: {fb_id} and {ACCESSTOKEN} / {version} and {PhoneNumberId} are filled in by the app.
FACEBOOK_GRAPH_URL=
FACEBOOK_WHATSAPP_MESSAGE=
FACEBOOK_GRAPH_VERSION=v19.0
