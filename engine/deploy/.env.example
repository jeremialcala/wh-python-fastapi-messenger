# The .env of /srv/apps/hive-engine/ on midgard (root, 600), next to docker-compose.yml. No secret goes here: the
# secret ids and the key of the LLM are files in keys/.

# Which build of ghcr.io/jeremialcala/chatbot-engine runs.
ENGINE_IMAGE_TAG=

# The audience of the tokens to the gateway's management API (ADR-0024 of the gateway). The same as its .env.
GATEWAY_AUDIENCE=https://hive-api.higerotech.com

# Hive's llama.cpp on the LAN (ADR-0010), for the classifier and the responder.
LLM_URL=http://192.168.10.74:8080

# The AppRole of the coordinator and the notifier in Andvari, as andvari's motor/emitir-trabajadores.sh prints them.
# Not secret.
COORDINATOR_ROLE_ID=
NOTIFIER_ROLE_ID=
