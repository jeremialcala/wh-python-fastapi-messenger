# The .env of /srv/apps/hive-engine/ on midgard (root, 600), next to docker-compose.yml. No secret goes here: the
# secret ids are files in keys/, and the keys of the Anthropic API live in Andvari.

# Which build of ghcr.io/jeremialcala/chatbot-engine runs.
ENGINE_IMAGE_TAG=

# The audience of the tokens to the gateway's management API (ADR-0024 of the gateway). The same as its .env.
GATEWAY_AUDIENCE=https://hive-api.higerotech.com

# The AppRole of each worker in Andvari, as andvari's motor/emitir-trabajadores.sh prints them. Not secret.
CLASSIFIER_ROLE_ID=
COORDINATOR_ROLE_ID=
RESPONDER_ROLE_ID=
NOTIFIER_ROLE_ID=
