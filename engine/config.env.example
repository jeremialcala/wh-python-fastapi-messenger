# ============================================================
#  config.env.example
#  Copy this file to "config.env" and fill in the values.
#  Each variable maps to an attribute of classes/tool_settings.py:Settings
# ============================================================

# --- General service ---
service_name=ms-python-template
environment=development          # development | staging | production
version=1.0.0
national_id_url=https://example.com/national-id

# --- MongoDB ---
db_name=mydb
db_host=mongodb://localhost:27017
db_username=mongo_user
db_password=change_me

# --- RabbitMQ (AMQP) ---
qms_server=localhost
qms_port=5672
qms_user=guest
qms_password=guest

queue_name=users
amqp_exchange=my_exchange
amqp_routing_key=users.#

# --- Cryptography (JWE / JWK) ---
key_size=2048
private_key_filename=certs/private.pem
public_key_filename=certs/public.pem

# --- JSON Schemas (single-line JSON strings) ---
# Schema used to build the dynamic ORM (mongoengine) entity model.
entity_schema={"firstName": {"type": "StringField", "required": true, "unique": false}}

# Schema describing the JWK document stored in the database.
entity_jwk={"kid": {"type": "StringField", "required": true, "unique": true}}

# Schema used to build the dynamic DTO (pydantic) model.
dto_schema={"firstName": {"type": "string", "description": "User first name"}}

# Schema for the inbound AMQP message envelope (DTO).
dto_message={"client_id": {"type": "string", "description": "Client identifier"}, "resource": {"type": "string", "description": "Target resource"}, "operation": {"type": "string", "description": "CRUD operation"}, "messageId": {"type": "string", "description": "Message identifier"}, "destination": {"type": "string", "description": "Destination id"}, "origen": {"type": "string", "description": "Origin id"}, "body": {"type": "string", "description": "Base64/encrypted payload"}}
